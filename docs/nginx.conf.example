# ตัวอย่าง nginx.conf สำหรับ deploy KUSHOP (Lab 12)
#
# ขั้นตอน
#   1) npm run build                       -> ได้โฟลเดอร์ dist/
#   2) copy ทุกไฟล์ใน dist/ ไปไว้ที่ <nginx>/html/
#   3) เอา server block ข้างล่างไปแทนใน <nginx>/conf/nginx.conf
#   4) start nginx            (หยุด: nginx -s stop, โหลดค่าใหม่: nginx -s reload)
#   5) เปิด http://localhost   แล้วรัน backend ไว้ที่ port 3000 ด้วย (npm run server)
#
# CORS ฝั่ง backend เปิดรับ http://localhost, http://127.0.0.1 และ port 4173 (npm run preview)
# ไว้แล้วใน server.js

server {
    listen       80;
    server_name  localhost;

    root   html;
    index  index.html;

    # Vue Router ใช้ history mode: ถ้าไม่มีไฟล์จริงให้ส่ง index.html กลับไป
    # ไม่งั้นกด refresh ที่ /product หรือ /cartlist แล้วจะขึ้น 404
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ไฟล์ static ของ Vite มี hash ในชื่ออยู่แล้ว cache ได้ยาว
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   html;
    }
}

# ถ้าไม่อยากให้ frontend เรียก http://localhost:3000 ตรง ๆ ก็ให้ nginx เป็น reverse proxy แทน
# (ต้องแก้ URL ใน frontend ให้เป็น /api/... ด้วย)
